{
    "workbench.sideBar.location": "right",
    "workbench.iconTheme": "vscode-icons",
    "vscord.status.details.text.debugging": "Debug: {file_name}{file_extension}",
    "vscord.status.details.text.editing": "Workspace: {workspace}",
    "vscord.status.details.text.idle": "Away From Keyboard.",
    "vscord.status.details.text.notInFile": "",
    "vscord.status.details.text.noWorkSpaceText": "",
    "vscord.status.details.text.viewing": "Workspace: {workspace}",
    "vscord.status.state.text.debugging": "Workspace: {workspace}",
    "vscord.status.state.text.editing": "Edit: {file_name}{file_extension}",
    "vscord.status.state.text.noWorkspaceFound": "",
    "vscord.status.state.text.viewing": "View: {file_name}{file_extension}",
    "vscord.status.image.large.idle.text": "AFK",
    "vscord.status.image.small.idle.text": "",
    "vscord.status.image.small.notInFile.text": "",
    "editor.fontSize": 14,
    "editor.fontFamily": "cascadia code, SF Mono, JetBrains Mono, monaspace argon, SF Mono Thin, SF Mono Medium, consolas, ibm plex mono",
    "editor.tokenColorCustomizations": {
        "textMateRules": [
            {
                "scope": ["comment"],
                "settings": {
                    "foreground": "#b6b6b6"
                }
            },
            {
                "scope": ["constant", "storage.modifier", "storage.type.class.js", "keyword", "keyword.function", "keyword.constructor"],
                "settings": {
                    "fontStyle": "italic"
                }
            },
            {
                "scope": ["keyword.operator"],
                "settings": {
                    "fontStyle": ""  // Remove italic from operators
                }
            },
            {
                "scope": ["support.function.console", "meta.function-call.js", "meta.method-call.js"],
                "settings": {
                    "fontStyle": ""  // Remove italic for function and method calls
                }
            },
            {
                "scope": ["entity.name.class"],
                "settings": {
                    "fontStyle": "italic"  // Italicize class names
                }
            },
            {
                "scope": ["variable.parameter"],
                "settings": {
                    "fontStyle": ""  // Make function parameters non-italic
                }
            },
            {
                "scope": ["punctuation.definition.parameters", "punctuation.section.parameters"],
                "settings": {
                    "fontStyle": ""  // Make parentheses non-italic
                }
            }
        ]
    },
    "editor.wordWrap": "on",
    "editor.cursorStyle": "line",
    "editor.bracketPairColorization.independentColorPoolPerBracketType": true,
    "workbench.colorCustomizations": {
        "activityBar.foreground": "#ffffff"
    },
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "prettier.tabWidth": 4,
    "prettier.trailingComma": "all",
    "prettier.vueIndentScriptAndStyle": true,
    "vscord.app.name": "Visual Studio Code",
    "oneDarkPro.vivid": true,
    "terminal.integrated.defaultProfile.windows": "Git Bash",
    "discord.lowerDetailsNoWorkspaceFound": "",
    "discord.lowerDetailsIdling": "",
    "discord.largeImageIdling": "",
    "editor.tabSize": 4,
    "editor.tabCompletion": "on",
    "indentRainbow.indicatorStyle": "classic",
    "glassit.alpha": 255,
    "workbench.editor.editorActionsLocation": "titleBar",
    "workbench.editor.highlightModifiedTabs": true,
    "workbench.editor.tabSizingFixedMaxWidth": 110,
    "window.density.editorTabHeight": "compact",
    "prettier.withNodeModules": true,
    "prettier.useTabs": true,
    "prettier.semi": false,
    "terminal.integrated.fontFamily": "SF Mono Thin, sf mono",
    "terminal.integrated.fontWeightBold": "normal",
    "editor.fontWeight": "normal",
    "editor.fontLigatures": false,
    "editor.experimentalWhitespaceRendering": "font",
    "indentRainbow.lightIndicatorStyleLineWidth": 1,
    "indentRainbow.ignoreLinePatterns": [
        "/[ \t]* [*]/g",
        "/[ \t]+[/]{2}/g"
    ],
    "editor.wrappingIndent": "deepIndent",
    "vscord.status.image.large.editing.text": "Editing the {LANG} file",
    "vscord.status.image.large.viewing.text": "Viewing the {LANG} file",
    "vscord.behaviour.statusBarAlignment": "Right",
    "terminal.integrated.env.windows": {},
    "console-ninja.featureSet": "Community",
    "files.autoSave": "afterDelay",
    "vscode-pets.petSize": "medium",
    "vscode-pets.petType": "totoro",
    "vscode-pets.theme": "beach",
    "workbench.colorTheme": "One Dark Pro Darker"
}
